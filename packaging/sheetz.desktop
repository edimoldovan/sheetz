[Desktop Entry]
Type=Application
Name=Sheetz
GenericName=Spreadsheet
Comment=Fast native spreadsheet with Excel keybindings
Exec=sheetz %f
Icon=sheetz
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;text/csv;
Keywords=spreadsheet;xlsx;excel;calc;
StartupNotify=true
StartupWMClass=sheetz
